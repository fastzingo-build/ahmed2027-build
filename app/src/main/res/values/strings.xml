    <string name="shield_service_label">AHMED Shield</string>
    <string name="shield_service_description">Sees only which app has come to the front, so AHMED can show its pause or blocked screen. It cannot read the screen, passwords, messages or notifications.</string>
    <string name="section_shield">Shield</string>
    <string name="shield_explain">The Shield notices when a Blocked or Limited app, or TikTok / Instagram outside your daily session, comes to the front, and shows AHMED’s own screen instead. It only learns the app’s name. It cannot read what is on screen, passwords, messages or notifications. Phone, SMS, Settings, Clock and Maps are never touched. To turn it on you enable “AHMED Shield” in Android’s Accessibility settings yourself.</string>
    <string name="shield_status_on">Shield is running.</string>
    <string name="shield_status_off">Shield is not running. Blocked and Limited labels are only labels until you enable it.</string>
    <string name="shield_status_paused">Shield is switched off in AHMED.</string>
