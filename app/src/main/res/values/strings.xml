    <string name="shield_toggle_on">Switch Shield on</string>
    <string name="shield_toggle_off">Switch Shield off</string>
    <string name="shield_open_failed">Could not open Accessibility settings.</string>
    <string name="shield_banner">Shield is not running, so Blocked and Limited apps are not enforced. Open More to set it up.</string>
